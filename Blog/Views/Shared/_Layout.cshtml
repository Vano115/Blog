@using Microsoft.AspNetCore.Identity;
@using Blog.Data.Entityes;
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Blog</title>
    <script type="importmap"></script>
    <link rel="stylesheet" type="text/css" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" type="text/css" href="~/Blog.styles.css" asp-append-version="true" />
    <link rel="stylesheet" type="text/css" href="~/css/header.css" asp-append-version="true" />
    <link rel="stylesheet" type="text/css" href="~/css/body.css" asp-append-version="true" />
    <link rel="stylesheet" type="text/css" href="~/css/footer.css" asp-append-version="true" />
</head>
<body>
    <header class="header">
        <div class="header-container">
            <a class="img-menu" asp-area="" asp-controller="Home" asp-action="Index">
                <img class="img-menu-logo" src="~/pictures/Logotype.png" />
            </a>
            <div class="button-menu">
                <a class="text-button-menu" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
            </div>
            <div class="button-menu">
                <a class="text-button-menu" asp-area="" asp-controller="Home" asp-action="Index">Выход</a>
            </div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            &copy; 2025 - Blog - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
