@model Blog.Data.Models.BlogModels.ArticleViewModel

<div>
    <script src="https://ajax.aspnetcdn.com/ajax/jquery.validate/1.17.0/jquery.validate.min.js"></script>
    <script src="https://ajax.aspnetcdn.com/ajax/jquery.validation.unobtrusive/3.2.10/jquery.validate.unobtrusive.min.js"></script>

    <h2>Создание статьи</h2>
    <form class="main" method="post" asp-controller="Blog" asp-action="CreateArticle">
        <div asp-validation-summary="ModelOnly"></div>
        <div>
            <label asp-for="Title"></label><br />
            <input asp-for="Title" />
            <span asp-validation-for="Title"></span>
        </div>
        <div>
            <label asp-for="Text"></label><br />
            <input asp-for="Text" />
            <span asp-validation-for="Text"></span>
        </div>
        <div>
            <label asp-for="Tags"></label><br />
            <input asp-for="Tags" />
            <span asp-validation-for="Tags"></span>
        </div>
        <div>
            <button type="submit">Опубликовать</button>
        </div>
    </form>

</div>